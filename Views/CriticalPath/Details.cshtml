@model Licenta3.Models.Activity
@using Licenta3.Models.ViewModels
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Details";
}

<style>

    table {
        width: 100%;
        border-collapse: collapse;
    }

    .graphbutton {
        margin-top: 25px;
    }

    .container th {
        color: white;
    }

    .container p, .container h2, .container table, .container td {
        color: black;
    }

    th, td {
        padding: 8px;
        text-align: center;
        vertical-align: middle;
    }

    .footer {
        font-size: 20px;
    }

    td, th {
        color: black;
    }

    .footer {
        text-align: left;
        margin-top: 20px;
        color: black;
    }

        .footer .element {
            margin-bottom: 15px;
        }

    th:nth-child(3), td:nth-child(3) {
        width: 17%;
    }

    td.critical {
        color: orangered;
    }

</style>

<div class="container py-3">
    <div class="row pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary">Detaliile activității <i><b>@Html.DisplayFor(model => model.Name)</b></i></h2>
        </div>
        <div class="col-12 col-md-6 d-flex flex-column flex-md-row justify-content-md-end align-items-start mt-3 mt-md-0">
            @{
                var user = await UserManager.GetUserAsync(User);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);

                    if (!roles.Contains("Manager"))
                    {
                        <a asp-controller="MemberHome" asp-action="Update" asp-route-id="@Model.Id"
                           class="btn btn-outline-success mx-0 mx-md-2 mb-2 mb-md-0"><i class="bi bi-trash-fill"></i>Actualizează</a>
                    }

                }
                <a href="javascript:history.back()" class="btn btn-outline-info"><i class="bi bi-trash-fill"></i>Înapoi spre estimare</a>
            }
        </div>
    </div>
</div>

<br />

<div class="table-responsive">

    <table class="table table-bordered table-striped" style="width:100%">
        <thead class="table-primary">
            <tr>
                <th>Durata Activitate</th>
                <th>Early Start Date</th>
                <th>Early Finish Date</th>
                <th>Late Start Date</th>
                <th>Late Finish Date</th>
                <th>Rezervă</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Html.DisplayFor(model => model.Duration) @Html.DisplayFor(model => model.MeasurementUnit)</td>
                <td>@Html.DisplayFor(model => model.EarlyStartDate)</td>
                <td>@Html.DisplayFor(model => model.EarlyFinishDate)</td>
                <td>@Html.DisplayFor(model => model.LateStartDate)</td>
                <td>@Html.DisplayFor(model => model.LateFinishDate)</td>
                <td>@Html.DisplayFor(model => model.Slack) @Html.DisplayFor(model => model.MeasurementUnit)</td>
            </tr>

        </tbody>
    </table>

    <div>
        <table class="table">
            <tbody>
                <tr>
                    <td class="table-primary text-light" style="text-align: left;">Cod</td>
                    <td style="text-align: left;">@Html.DisplayFor(model => model.Code)</td>
                </tr>
                <tr>
                    <td width="15%" class="table-primary text-light" style="text-align: left;">Denumire</td>
                    <td width="85%" style="text-align: left;">@Html.DisplayFor(model => model.Name)</td>
                </tr>
                <tr>
                    <td class="table-primary text-light" style="text-align: left;">Status</td>
                    <td style="text-align: left;">@Html.DisplayFor(model => model.State)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<h5 class="mt-4"><b>Condiționări</b></h5>

@if (ViewBag.Dependencies is List<ValueTuple<string, string>> dependenciesList && dependenciesList.Any())
{
    <ul>
        @foreach (var dep in dependenciesList)
        {
            <li><strong>@dep.Item1</strong> - @dep.Item2</li>
        }
    </ul>
}
else
{
    <p><em>Nicio activitate.</em></p>
}

<h5 class="mt-4"><b>Resurse necesare</b></h5>
@if (ViewBag.Resources != null && ((List<TaskResourceDisplayViewModel>)ViewBag.Resources).Any())
{
    <ul>
        @foreach (var res in (List<TaskResourceDisplayViewModel>)ViewBag.Resources)
        {
            <li><b>@res.ResourceName</b> – @res.QuantityUsed @res.MeasurementUnit</li>
        }
    </ul>
}
else
{
    <p><em>Nicio resursă alocată.</em></p>
}
</div>
