@model Licenta3.Models.Activity
@using Licenta3.Models.ViewModels
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Detalii Activitate";

    string GetStatusColor(string state) => state switch
    {
        "Finalizată" => "bg-success",
        "În execuție" => "bg-info text-dark",
        "Întârziată" => "bg-danger",
        _ => "bg-primary"
    };

    string GetSlackColor(decimal slack) => slack == 0 ? "text-danger fw-bold" : "text-success fw-bold";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <div class="d-flex align-items-center mb-3 mb-md-0">
                        <div class="bg-opacity-25 p-3 me-3">
                            <i class="bi bi-info-circle-fill fs-3 text-white"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Detalii Activitate</h4>
                            <small class="text-white-50">Vizualizare completă a parametrilor</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        @{
                            var user = await UserManager.GetUserAsync(User);
                            if (user != null)
                            {
                                var roles = await UserManager.GetRolesAsync(user);
                                if (!roles.Contains("Manager"))
                                {
                                    <a asp-controller="MemberHome" asp-action="Update" asp-route-id="@Model.Id"
                                       class="btn btn-light text-primary fw-bold shadow-sm">
                                        <i class="bi bi-pencil-square me-2"></i>Actualizează
                                    </a>
                                }
                            }
                        }
                        <a href="javascript:history.back()" class="btn btn-outline-light border-0">
                            <i class="bi bi-arrow-left me-2"></i>Înapoi
                        </a>
                    </div>
                </div>

                <div class="card-body p-4 bg-white">

                    <div class="row g-4 mb-5">
                        <div class="col-md-8">
                            <h2 class="fw-bold text-dark mb-1">@Model.Name</h2>
                            <div class="d-flex align-items-center text-muted">
                                <i class="bi bi-upc-scan me-2"></i>
                                <span class="me-3">Cod: <strong>@Model.Code</strong></span>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <label class="small text-muted text-uppercase fw-bold d-block mb-1">Status Curent</label>
                            <span class="badge @GetStatusColor(Model.State) rounded-pill px-3 py-2 fs-6 shadow-sm">
                                @Model.State
                            </span>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 my-4" />

                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-calendar-range me-2"></i>Planificare Temporală (CPM)
                    </h5>

                    <div class="table-responsive rounded-3 border shadow-sm mb-5">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="bg-light text-secondary">
                                <tr>
                                    <th class="py-3">Durată</th>
                                    <th>Early Start</th>
                                    <th>Early Finish</th>
                                    <th>Late Start</th>
                                    <th>Late Finish</th>
                                    <th>Rezervă</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span class="fw-bold fs-5">@Model.Duration</span>
                                        <small class="text-muted">@Model.MeasurementUnit</small>
                                    </td>
                                    <td class="text-primary">@(((DateTime)Model.EarlyStartDate).ToString("dd.MM.yyyy"))</td>
                                    <td class="text-primary">@(((DateTime)Model.EarlyFinishDate).ToString("dd.MM.yyyy"))</td>
                                    <td class="text-secondary">@(((DateTime)Model.LateStartDate).ToString("dd.MM.yyyy"))</td>
                                    <td class="text-secondary">@(((DateTime)Model.LateFinishDate).ToString("dd.MM.yyyy"))</td>
                                    <td class="@GetSlackColor(Model.Slack)">
                                        @Model.Slack <small class="fw-normal text-muted">@Model.MeasurementUnit</small>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="card h-100 border bg-light">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                        <i class="bi bi-diagram-2 me-2 text-primary"></i>Condiționări (Predecesori)
                                    </h6>

                                    @if (ViewBag.Dependencies is List<ValueTuple<string, string>> dependenciesList && dependenciesList.Any())
                                    {
                                        <ul class="list-group list-group-flush bg-transparent">
                                            @foreach (var dep in dependenciesList)
                                            {
                                                <li class="list-group-item bg-transparent px-0 py-2 d-flex align-items-center">
                                                    <span class="badge bg-white text-dark border me-2">@dep.Item1</span>
                                                    <span>@dep.Item2</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-muted small fst-italic mb-0">Această activitate nu depinde de altele (Start).</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 border bg-light">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                        <i class="bi bi-tools me-2 text-warning"></i>Resurse Necesare
                                    </h6>

                                    @if (ViewBag.Resources != null && ((List<TaskResourceDisplayViewModel>)ViewBag.Resources).Any())
                                    {
                                        <ul class="list-group list-group-flush bg-transparent">
                                            @foreach (var res in (List<TaskResourceDisplayViewModel>)ViewBag.Resources)
                                            {
                                                <li class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                                                    <span>@res.ResourceName</span>
                                                    <span class="badge bg-warning text-dark rounded-pill">
                                                        @res.QuantityUsed @res.MeasurementUnit
                                                    </span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-muted small fst-italic mb-0">Nicio resursă alocată momentan.</p>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>