@model List<Activity>
@using Microsoft.AspNetCore.Identity
@using System.Globalization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Estimarea CPM";
    string GetJsDate(DateTime date)
    {
        return $"new Date({date.Year}, {date.Month - 1}, {date.Day}, 0)";
    }

    var criticalPaths = ViewBag.CriticalPaths as List<List<Activity>>;
    var singleCriticalPath = criticalPaths?.FirstOrDefault();
}

@section Navbar {
    @{
        var method = Context.Request.Query["method"].ToString();
        if (string.IsNullOrEmpty(method))
        {
            method = Context.Request.RouteValues["method"]?.ToString();
        }
    }
}

<style>
    .table thead th {
        background-color: #0d6efd;
        color: white;
        border: none;
        vertical-align: middle;
    }

    .status-badge {
        padding: 5px 10px;
        border-radius: 12px;
        font-size: 0.85em;
        font-weight: bold;
    }

    .badge-critical {
        background-color: #ffebe6;
        color: #c92a2a;
        border: 1px solid #ffc9c9;
    }

    .badge-normal {
        background-color: #e7f5ff;
        color: #1864ab;
        border: 1px solid #d0ebff;
    }

    .path-container {
        background-color: #f8f9fa;
        border-left: 5px solid #0d6efd;
        padding: 15px;
        border-radius: 4px;
    }

    #gantt_chart_div {
        width: 100%;
        min-height: 400px;
        overflow-x: auto;
        overflow-y: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 8px;
        text-align: center;
        vertical-align: middle;
    }

    .footer {
        font-size: 20px;
    }

    td, th {
        color: black;
    }


    .footer {
        text-align: left;
        margin-top: 20px;
        color: black;
    }

        .footer .element {
            margin-bottom: 15px;
        }

    th:nth-child(3), td:nth-child(3) {
        width: 17%;
    }

    td.critical {
        color: orangered;
    }

    .chart-scroll-wrapper {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        border-radius: 4px;
    }

    #gantt_chart_div {
        width: 100%;
        min-width: 900px;
    }

</style>

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

<div class="container py-3">
    <div class="row pt-4 align-items-center">
        <div class="col-md-6">
            @{
                var method = Context.Request.Query["method"].ToString();
                var displayTitle = (method == "Level") ? "Optimizată (Nivelată)" : "Inițială (CPM)";
            }
            <h2 class="text-primary fw-bold">Estimare @displayTitle</h2>
            <p class="text-muted">Vizualizare grafică și tabelară a proiectului.</p>
        </div>
        <div class="col-md-6 text-md-end">
            @{
                var displayName = (method == "Level") ? "Revenire la estimarea inițială" : "Nivelare Resurse";
                var alternateMethod = (method == "Level") ? "Normal" : "Level";
                var btnClass = (method == "Level") ? "btn-outline-primary" : "btn-success";
            }
            <a asp-controller="CriticalPath" asp-action="CalculateCriticalPath" asp-route-id="@ViewBag.Id" asp-route-method="@alternateMethod" class="me-2 btn @btnClass">
                <i class="bi bi-shuffle"></i> @displayName
            </a>
            <a asp-controller="CriticalPath" asp-action="OptimizedSchedule" asp-route-id="@ViewBag.Id" asp-route-method="@method" asp-route-view="Histogram" class="btn btn-primary my-2">
                <i class="bi bi-bar-chart-fill"></i> Histograma Resurselor
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-5 mt-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Grafic Gantt</h5>
            <button id="btn-download-chart" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-download"></i> Descarcă PNG
            </button>
        </div>
        <div class="card-body p-0">
            <div class="chart-scroll-wrapper p-3">
                <div id="gantt_chart_div" style="background-color: white;"></div>
            </div>
        </div>
    </div>

    @{
        var resourceHistograms = ViewBag.ResourceHistograms as IDictionary<string, ResourceHistogram>;
    }
    @if (ViewBag.OveruseSummary != null && ((Dictionary<string, List<string>>)ViewBag.OveruseSummary).Any())
    {
        <div class="alert alert-danger shadow-sm">
            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Atenție: Resurse supra-alocate!</h5>
            <hr>
            @foreach (var item in (Dictionary<string, List<string>>)ViewBag.OveruseSummary)
            {
                <strong>@item.Key:</strong>
                <ul class="mb-1">
                    @foreach (var msg in item.Value)
                    {
                        <li>@msg</li>
                    }
                </ul>
            }
            <div class="mt-2">
                <small>Recomandăm folosirea funcției <b>"Nivelare Resurse"</b> de mai sus.</small>
            </div>
        </div>

    }

    <div class="card shadow-sm my-5">
        <div class="card-header bg-white">
            <h5 class="mb-0"> Detalii Activități</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped mb-0" style="width:100%">
                <thead class="table-primary">
                    <tr>
                        <th>Nr. crt</th>
                        <th>Cod</th>
                        <th>Denumire</th>
                        <th>Durată</th>
                        <th>Early Start Date</th>
                        <th>Early Finish Date</th>
                        <th>Late Start Date</th>
                        <th>Late Finish Date</th>
                        <th>Rezervă</th>
                        <th>Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        decimal x = 0;
                        var y = 1;
                    }
                    @foreach (var activity in Model)
                    {
                        <tr>
                            <td>@y</td>
                            <td>@activity.Code</td>
                            <td class="@((activity.IsCritical) ? "critical" : "")">@activity.Name</td>
                            <td class=>@activity.Duration @ViewBag.Um</td>
                            <td>@(((DateTime)activity.EarlyStartDate).ToString("dd/MM/yyyy"))</td>
                            <td>@(((DateTime)activity.EarlyFinishDate).ToString("dd/MM/yyyy"))</td>
                            <td>@(((DateTime)activity.LateStartDate).ToString("dd/MM/yyyy"))</td>
                            <td>@(((DateTime)activity.LateFinishDate).ToString("dd/MM/yyyy"))</td>
                            <td>
                                @if (activity.IsCritical)
                                {
                                    <span class="status-badge badge-critical">@activity.Slack</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-normal">@activity.Slack</span>
                                }
                            </td>
                            <td>
                                <div class="w-80 btn-group" role="group">
                                    <a asp-controller="CriticalPath" asp-action="Details" asp-route-id="@activity.Id" asp-route-method="@method"
                                       class="btn btn-outline-success mx-2">Detalii</a>
                                </div>
                            </td>
                        </tr>

                        x = @activity.LateFinish;
                        (@y)++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (ViewBag.LevelingImpact != null)
    {
        <div class="card mb-5 shadow-sm border-left-primary">
            <div class="card-header bg-light">
                <h5 class="mb-0 text-dark">Raport Nivelare Resurse</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    @foreach (var line in ViewBag.LevelingImpact as List<string>)
                    {
                        <li class="mb-1">@Html.Raw(line)</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <div class="path-container shadow-sm">
                <h5>Rezumat Proiect</h5>
                <p>
                    Proiectul începe pe <b>@(((DateTime)ViewBag.StartingDate).ToString("dd/MM/yyyy"))</b>
                    și se estimează a fi finalizat pe <b>@(((DateTime)ViewBag.FinishingDate).ToString("dd/MM/yyyy"))</b>.
                    Durata totală: <b>@Model.Max(a => a.ScheduledFinish) @ViewBag.Um</b>.
                </p>

                @if (singleCriticalPath != null)
                {
                    <hr />
                    <h5>Drumul Critic Optim</h5>
                    <p class="mb-0 text-dark">
                        @foreach (var activity in singleCriticalPath)
                        {
                            <span class="fw-bold">@activity.Name</span>
                            @if (activity != singleCriticalPath.Last())
                            {
                                <i class="bi bi-arrow-right mx-2 text-muted"></i>
                            }
                        }
                    </p>
                }
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    google.charts.load('current', { 'packages': ['gantt'] });
    google.charts.setOnLoadCallback(drawChart);

    function drawChart() {
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Task ID');
        data.addColumn('string', 'Task Name');
        data.addColumn('string', 'Resource');
        data.addColumn('date', 'Start Date');
        data.addColumn('date', 'End Date');
        data.addColumn('number', 'Duration');
        data.addColumn('number', 'Percent Complete');
        data.addColumn('string', 'Dependencies');

        data.addRows([
            @foreach (var activity in Model
                .Where(a => !string.Equals(a.Code?.Trim(), "STOP", StringComparison.OrdinalIgnoreCase)) // Filtrează orice variație: "Stop", "STOP ", "stop"
                .OrderBy(a => a.EarlyStartDate)) // Păstrează și sortarea cronologică pentru aspect curat
            {
                                    var dependencies = (activity.Dependencies == "-" || string.IsNullOrEmpty(activity.Dependencies)) ? "null" : $"'{activity.Dependencies.Replace(",", ",")}'";
                                    var resourceType = activity.IsCritical ? "critical" : "normal";

                                    <text>
                                    [
                                        @Html.Raw(Json.Serialize(activity.Code)),
                                        @Html.Raw(Json.Serialize(activity.Name)),
                                        @Html.Raw(Json.Serialize(resourceType)),
                                        @Html.Raw(GetJsDate(activity.EarlyStartDate)),
                                        @Html.Raw(GetJsDate(activity.EarlyFinishDate)),
                                        null,
                                        0,
                                        @Html.Raw(dependencies)
                                    ],
                                    </text>
            }
        ]);

        var rowHeight = 45;
        var chartHeight = (data.getNumberOfRows() * rowHeight) + 50;

        var options = {
            height: chartHeight,
            gantt: {
                trackHeight: 40,
                barHeight: 25,
                percentEnabled: false,
                sortTasks: true,
                palette: [
                    {
                        "color": "#1976d2",
                        "dark": "#0d47a1",
                        "light": "#bbdefb"
                    },
                    {
                        "color": "#d32f2f",
                        "dark": "#b71c1c",
                        "light": "#ffcdd2"
                    }
                ],
                arrow: {
                    angle: 45,
                    radius: 0,
                    color: '#666',
                    width: 1.5
                }
            }
        };

        var container = document.getElementById('gantt_chart_div');
        var chart = new google.visualization.Gantt(container);

        google.visualization.events.addListener(chart, 'ready', function () {
            var btnDownload = document.getElementById('btn-download-chart');

            var newBtn = btnDownload.cloneNode(true);
            btnDownload.parentNode.replaceChild(newBtn, btnDownload);

            newBtn.addEventListener('click', function () {
                html2canvas(container, { backgroundColor: "#ffffff", scale: 2 }).then(canvas => {
                    var imgUri = canvas.toDataURL("image/png");
                    var link = document.createElement("a");
                    link.href = imgUri;
                    link.download = 'Grafic_Gantt_Proiect.png';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                });
            });
        });

        chart.draw(data, options);
    }
</script>