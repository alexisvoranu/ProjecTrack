@model List<Activity>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@section Navbar {
    @{
        var method = Context.Request.Query["method"].ToString();
        if (string.IsNullOrEmpty(method))
        {
            method = Context.Request.RouteValues["method"]?.ToString();
        }
    }

    <a asp-controller="CriticalPath"
       asp-action="Index"
       asp-route-id="@ViewBag.Id"
       asp-route-method="@method"
       asp-route-selectedId="1"
       class="btn btn-light mx-3">
        Afișează graficul estimării
    </a>

    <a asp-controller="CriticalPath"
       asp-action="OptimizedSchedule"
       asp-route-id="@ViewBag.Id"
       asp-route-method="@method"
       asp-route-view="Histogram"
       class="btn btn-light">
        Histograma resurselor
    </a>
}

<style>

    table {
        width: 100%;
        border-collapse: collapse;
    }

    .graphbutton {
        margin-top: 25px;
    }

    .container th {
        color: white;
    }

    .container p, .container h2, .container table, .container td {
        color: black;
    }


    th, td {
        padding: 8px;
        text-align: center;
        vertical-align: middle;
    }

    .footer {
        font-size: 20px;
    }

    td, th {
        color: black;
    }


    .footer {
        text-align: left;
        margin-top: 20px;
        color: black;
    }

        .footer .element {
            margin-bottom: 15px;
        }

    th:nth-child(3), td:nth-child(3) {
        width: 17%;
    }

    td.critical {
        color: orangered;
    }

</style>

<div class="container py-3">
    <div class="row pt-4">
        <div class="col-6">
            @{
                var method = Context.Request.Query["method"].ToString();
                if (string.IsNullOrEmpty(method))
                {
                    method = Context.Request.RouteValues["method"]?.ToString();
                }

                var displayTitle = (method == "Level") ? "optimizată" : "inițială";
                <h2 class="text-primary">Estimarea @displayTitle</h2>
            }
        </div>
        <div class="col-6 d-flex justify-content-end">
            @{
                var user = await UserManager.GetUserAsync(User);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);

                    if (roles.Contains("Manager"))
                    {
                        <a asp-controller="Task" asp-action="Index" asp-route-id="@ViewBag.Id" asp-route-method="@method"
                           class="btn btn-outline-info mx-2"><i class="bi bi-trash-fill"></i>Înapoi spre lista activităților</a>
                    }
                    else
                    {
                        <a asp-controller="MemberHome" asp-action="Tasks" asp-route-id="@ViewBag.Id" asp-route-method="@method"
                           class="btn btn-outline-info"><i class="bi bi-trash-fill"></i>Înapoi spre lista activităților</a>
                    }
                }

                var displayName = (method == "Level") ? "Inițială" : "Optimizată";
                var alternateMethod = (method == "Level") ? "Normal" : "Level";
            }

            <a asp-controller="CriticalPath" asp-action="CalculateCriticalPath" asp-route-id="@ViewBag.Id" asp-route-method="@alternateMethod" class="btn btn-success">
                <i class="bi bi-plus-circle"></i>Estimarea @displayName
            </a>

        </div>
    </div>
</div>

@{
    var resourceHistograms = ViewBag.ResourceHistograms as IDictionary<string, ResourceHistogram>;
    foreach (var item in resourceHistograms)
    {
        var resource = item.Value.Resource;
        <div class="card mb-2 border-0 rounded-3">
            @if (ViewBag.OveruseSummary != null && ViewBag.OveruseSummary.ContainsKey(resource.Name))
            {
                <div class="alert alert-warning mt-3">
                    <strong>Supra-alocări detectate pentru @resource.Name:</strong>
                    <ul class="mb-0">
                        @foreach (var msg in ViewBag.OveruseSummary[resource.Name])
                        {
                            <li>@msg</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
}

<table class="table table-bordered table-striped" style="width:100%">
    <thead class="table-primary">
        <tr>
            <th>Nr. crt</th>
            <th>Cod Activitate</th>
            <th>Denumire Activitate</th>
            <th>Durata Activitate</th>
            <th>Early Start Date</th>
            <th>Early Finish Date</th>
            <th>Late Start Date</th>
            <th>Late Finish Date</th>
            <th>Rezervă</th>
            <th>Acțiuni</th>
        </tr>
    </thead>
    <tbody>
        @{
            decimal x = 0;
            var y = 1;
        }
        @foreach (var activity in Model)
        {
            <tr>
                <td>@y</td>
                <td>@activity.Code</td>
                <td class="@((activity.IsCritical) ? "critical" : "")">@activity.Name</td>
                <td class=>@activity.Duration @ViewBag.Um</td>
                <td class="@((activity.IsCritical) ? "critical" : "")">@activity.EarlyStartDate</td>
                <td class="@((activity.IsCritical) ? "critical" : "")">@activity.EarlyFinishDate</td>
                <td class="@((activity.IsCritical) ? "critical" : "")">@activity.LateStartDate</td>
                <td class="@((activity.IsCritical) ? "critical" : "")">@activity.LateFinishDate</td>
                <td class="@((activity.IsCritical) ? "critical" : "")">@activity.Slack</td>
                <td>
                    <div class="w-80 btn-group" role="group">
                        @if (activity.Name != "STOP")
                        {
                            <a asp-controller="CriticalPath" asp-action="Details" asp-route-id="@activity.Id" asp-route-method="@method"
                               class="btn btn-outline-success mx-2"><i class="bi bi-pencil-square"></i>Detalii</a>
                        }

                    </div>
                </td>
            </tr>

            x = @activity.LateFinish;
            (@y)++;
        }
    </tbody>
</table>

<div class="footer">

    <div class="element my-4">
        Durata minimă de realizare a proiectului cu data de începere <b>@ViewBag.StartingDate</b> este de <b>@x @ViewBag.Um</b>, acesta urmând să fie finalizat la data de <b>@ViewBag.FinishingDate</b>
    </div>
    @{
        List<Activity> criticalActivities = new List<Activity>();
        List<Activity> nonCriticalActivities = new List<Activity>();

        foreach (var activity in Model)
        {
            if (activity.Slack == 0)
                criticalActivities.Add(activity);
            else
                nonCriticalActivities.Add(activity);
        }
    }

    @{
        var criticalPaths = ViewBag.CriticalPaths as List<List<Activity>>;
    }

    @if (criticalPaths != null)
    {
        <h4><b>@(criticalPaths.Count > 1 ? "Drumurile critice sunt:" : "Drumul critic este:")</b></h4>
        <ul>
            @foreach (var path in criticalPaths)
            {
                <li>
                    @foreach (var activity in path)
                    {
                        <span>@activity.Name</span>
                        @if (activity != path.Last())
                        {
                            <span> -> </span>
                        }
                    }
                </li>
            }
        </ul>
    }

    <div class="element my-4">
        <h4><b>Activitățile critice sunt:</b></h4>
        <ul>
            @foreach (var activity in criticalActivities.Where(a => a.Name != "STOP"))
            {
                <li>
                    <span>@activity.Name</span>
                </li>
            }
        </ul>
    </div>

    <div class="element">
        <h4><b>Activitățile non-critice sunt:</b></h4>
        <ul>
            @foreach (var activity in nonCriticalActivities)
            {
                <li>
                    <span>@activity.Name</span>

                </li>
            }
        </ul>
    </div>
</div>