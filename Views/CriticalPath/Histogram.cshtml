@using Licenta3.Models@{
    ViewData["Title"] = "Histograma resurselor";
    var resourceHistograms = ViewBag.ResourceHistograms as IDictionary<string, ResourceHistogram>;
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container py-4">
    <div class="col-6">
        <h2 class="text-primary">Histograma resurselor</h2>
    </div>
</div>

@if (resourceHistograms == null || resourceHistograms.Count == 0)
{
    <div class="alert alert-info">Nu există date suficiente pentru generarea histogramelor.</div>
}
else
{
    string GetRandomColor(string taskName)
    {
        var hash = taskName.GetHashCode();
        var r = (hash & 0xFF0000) >> 16;
        var g = (hash & 0x00FF00) >> 8;
        var b = (hash & 0x0000FF) >> 0;
        return $"rgba({r % 200 + 55}, {g % 200 + 55}, {b % 200 + 55}, 0.8)";
    }

    foreach (var item in resourceHistograms)
    {
        var resource = item.Value.Resource;
        var usageDetails = item.Value.UsageDetails;

        var uniqueTasks = usageDetails.SelectMany(kvp => kvp.Value.Select(d => d.TaskName)).Distinct().ToList();

        var timePoints = usageDetails.Keys.OrderBy(t => t).ToList();
        var labels = timePoints
            .Select(t => $"{t} - {t + 1}")
            .ToList();

        var datasets = new List<object>();
        decimal maxUsage = 0;

        foreach (var taskName in uniqueTasks)
        {
            var taskData = new List<decimal>();
            decimal currentTaskMax = 0;

            foreach (var t in timePoints)
            {
                var detail = usageDetails[t].FirstOrDefault(d => d.TaskName == taskName);
                var qty = detail?.QuantityUsed ?? 0;
                taskData.Add(qty);
            }

            for (int i = 0; i < timePoints.Count; i++)
            {
                decimal totalForMoment = usageDetails[timePoints[i]].Sum(d => d.QuantityUsed);
                if (totalForMoment > maxUsage)
                {
                    maxUsage = totalForMoment;
                }
            }

            datasets.Add(new
            {
                label = $"{taskName}",
                data = taskData,
                backgroundColor = GetRandomColor(taskName),
                borderWidth = 1,
                order = 1
            });
        }

        datasets.Add(new
        {
            label = "Disponibil total",
            data = Enumerable.Repeat(resource.Quantity, labels.Count).ToArray(),
            type = "line",
            borderColor = "rgba(255, 99, 132, 1)",
            borderWidth = 2,
            fill = false,
            tension = 0,
            pointRadius = 0,
            order = 0
        });

        decimal maxResourceQuantity = resource.Quantity;
        decimal suggestedMaxY = Math.Max(maxResourceQuantity, maxUsage) * 1.1M;
        string suggestedMaxYString = suggestedMaxY.ToString(System.Globalization.CultureInfo.InvariantCulture);


        <div class="card shadow-sm mb-5 border-0 rounded-3">
            <div class="card-header bg-gradient text-white" style="background-color: #007bff;">
                <h5 class="mb-0 fw-bold">@resource.Name (@resource.MeasurementUnit)</h5>
                <small>Disponibil total: <strong>@resource.Quantity</strong></small>
            </div>
            <div class="card-body">
                <canvas id="chart-@resource.Id" height="120"></canvas>
            </div>
        </div>

        <script>
            const ctx_@resource.Id = document.getElementById('chart-@resource.Id').getContext('2d');
            const data_@resource.Id = {
                labels: @Html.Raw(Json.Serialize(labels)),
                    datasets: @Html.Raw(Json.Serialize(datasets))
                                    };

            // Variabila JavaScript pentru suggestedMaxY
            const suggestedMaxY_@resource.Id = parseFloat('@suggestedMaxYString');

            new Chart(ctx_@resource.Id, {
                type: 'bar',
                data: data_@resource.Id,
                options: {
                responsive: true,
                // 1. Ascunde legenda pentru linia "Disponibil total"
                plugins: {
                    legend: {
                        labels: {
                            filter: function (legendItem, chartData) {
                                // Afișează doar etichetele care NU sunt de tip 'line' (adică barele stivuite)
                                const dataset = chartData.datasets[legendItem.datasetIndex];
                                return dataset.type !== 'line';
                            }
                        }
                    },
                    // Tooltip-ul trebuie să arate totalul și fiecare componentă
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    },
                    tooltip: {
                        enabled: true // ACESTA dezactivează complet tooltip-ul la hover
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        offset: true,
                        barPercentage: 1.0,
                        categoryPercentage: 1.0,
                        ticks: {
                            stepSize: 1,
                        },
                        title: {
                            display: true,
                            text: 'Momentul de timp (t - t+1)'
                        }
                    },
                    y: {
                        stacked: true, // ESENȚIAL: Face ca valorile să se adune
                        // 2. Setează valoarea maximă sugerată pentru a adăuga spațiu deasupra (ex: 5.5 in loc de 5)
                        suggestedMax: suggestedMaxY_@resource.Id,
                title: {
                display: true,
                text: 'Cantitate necesară (@resource.MeasurementUnit)'
            }
                                                }
                                            }
                                        }
                                    });
        </script>
    }
}