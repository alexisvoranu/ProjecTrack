@using Licenta3.Models
@using System.Globalization
@{
    ViewData["Title"] = "Histograma resurselor";
    var resourceHistograms = ViewBag.ResourceHistograms as IDictionary<string, ResourceHistogram>;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<h2 class="my-4 text-primary text-center fw-bold">📊 Histograma utilizării resurselor</h2>

@if (resourceHistograms == null || resourceHistograms.Count == 0)
{
    <div class="alert alert-info">Nu există date suficiente pentru generarea histogramelor.</div>
}
else
{
    foreach (var item in resourceHistograms)
    {
        var resource = item.Value.Resource;
        var usage = item.Value.Usage;
        var labels = usage.Keys.Select(d => d.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)).ToList();
        var data = usage.Values.ToList();

        <div class="card shadow-sm mb-5 border-0 rounded-3">
            <div class="card-header bg-gradient text-white" style="background-color: #007bff;">
                <h5 class="mb-0 fw-bold">@resource.Name (@resource.MeasurementUnit)</h5>
                <small>Disponibil total: <strong>@resource.Quantity</strong> @resource.MeasurementUnit</small>
            </div>
            <div class="card-body">
                <canvas id="chart-@resource.Id" height="120"></canvas>
            </div>
        </div>

        <script>
            const ctx_@resource.Id = document.getElementById('chart-@resource.Id').getContext('2d');
            const data_@resource.Id = {
                labels: @Html.Raw(Json.Serialize(labels)),
                    datasets: [
                        {
                            label: 'Consum resursă',
                            data: @Html.Raw(Json.Serialize(data)),
                            backgroundColor: @Html.Raw(Json.Serialize(
        data.Select(v => v > (decimal)resource.Quantity ? "rgba(255, 99, 132, 0.7)" : "rgba(75, 192, 192, 0.7)")
        )),
                            borderWidth: 1
                        },
                        {
                            label: 'Disponibil total',
                            data: new Array(@data.Count).fill(@resource.Quantity),
                            type: 'line',
                            borderColor: 'rgba(255, 99, 132, 1)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.3,
                            pointRadius: 0
                        }
                    ]
            };

            new Chart(ctx_@resource.Id, {
                type: 'bar',
                data: data_@resource.Id,
                options: {
                plugins: {
                    legend: {
                        labels: { font: { size: 13 } }
                    },
                    title: {
                        display: true,
                        text: 'Evoluția utilizării resursei @resource.Name',
                        font: { size: 15, weight: 'bold' }
                    }
                },
                scales: {
                    x: {
                        title: { display: true, text: 'Zile' },
                        ticks: { maxRotation: 90, minRotation: 45 }
                    },
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: '@resource.MeasurementUnit' },
                        grid: { color: 'rgba(0,0,0,0.1)' }
                    }
                }
            }
                        });
        </script>
    }
}
