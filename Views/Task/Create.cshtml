@model Licenta3.Models.Task

@{
    ViewData["Title"] = "Creează o activitate";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                            <i class="bi bi-file-earmark-plus fs-3 text-white"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Activitate Nouă</h4>
                            <small class="text-white-50">Adaugă o sarcină în cadrul proiectului</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Create" asp-route-id="@ViewBag.ProjectId">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="Code" class="form-control shadow-sm" id="floatingCode" placeholder="Cod" />
                                    <label asp-for="Code" for="floatingCode"><i class="bi bi-upc me-1"></i> Cod</label>
                                    <span asp-validation-for="Code" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control shadow-sm" id="floatingName" placeholder="Nume Activitate" />
                                    <label asp-for="Name" for="floatingName"><i class="bi bi-card-text me-1"></i> Denumire</label>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Duration" type="number" step="0.5" class="form-control shadow-sm" id="floatingDuration" placeholder="Durata" />
                            <label asp-for="Duration" for="floatingDuration"><i class="bi bi-stopwatch me-1"></i> Durată estimată</label>
                            <span asp-validation-for="Duration" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Dependencies" class="form-label text-muted fw-bold small ms-1">
                                <i class="bi bi-link-45deg me-1"></i> Condiționări (Dependențe)
                            </label>
                            <select name="selectedDependencies" class="form-select shadow-sm" style="height: 120px;"
                                    asp-items="ViewBag.Dependencies"
                                    multiple>
                            </select>
                            <div class="form-text text-muted fst-italic ms-1">
                                <i class="bi bi-info-circle"></i> Ține apăsat <strong>Ctrl</strong> pentru a selecta mai multe.
                            </div>
                            <span asp-validation-for="Dependencies" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill shadow fw-bold">
                                <i class="bi bi-check-lg me-2"></i>Creează Activitatea
                            </button>

                            <a asp-controller="Task"
                               asp-action="Index"
                               asp-route-id="@ViewBag.ProjectId"
                               class="btn btn-outline-secondary rounded-pill px-4 border-0">
                                <i class="bi bi-arrow-left me-2"></i>Înapoi la Listă
                            </a>

                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}