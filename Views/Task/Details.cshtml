@model Licenta3.Models.Task
@using Licenta3.Models.ViewModels


@{
    ViewData["Title"] = "Detalii";
}

<div class="container py-3">
    <div class="row pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary">Activitatea <i><b>@Html.DisplayFor(model => model.Name)</b></i></h2>
        </div>
        <div class="col-12 col-md-6 d-flex flex-column flex-md-row justify-content-md-end align-items-start mt-3 mt-md-0">
            <a asp-controller="Task" asp-action="Index" asp-route-id="@Model.ProjectId"
               class="btn btn-outline-info mx-0 mx-md-2 mb-2 mb-md-0">
                <i class="bi bi-trash-fill"></i> Înapoi spre lista proiectelor
            </a>
        </div>
    </div>
</div>

<br />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            Cod
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Code)
        </dd>
        <dt class="col-sm-2">
            Denumire
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            Durată
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Duration) @ViewBag.Um
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.State)
        </dd>
        <dt class="col-sm-2">
            Proiect
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.Name)
        </dd>
    </dl>
    <h5 class="mt-4"><b>Condiționări</b></h5>

    @if (ViewBag.Dependencies is List<ValueTuple<string, string>> dependenciesList && dependenciesList.Any())
    {
        <ul>
            @foreach (var dep in dependenciesList)
            {
                <li><strong>@dep.Item1</strong> - @dep.Item2</li>
            }
        </ul>
    }
    else
    {
        <p><em>Nicio activitate.</em></p>
    }

    <h5 class="mt-4"><b>Resurse necesare</b></h5>
    @if (ViewBag.Resources != null && ((List<TaskResourceDisplayViewModel>)ViewBag.Resources).Any())
    {
        <ul>
            @foreach (var res in (List<TaskResourceDisplayViewModel>)ViewBag.Resources)
            {
                <li><b>@res.ResourceName</b> – @res.QuantityUsed @res.MeasurementUnit</li>
            }
        </ul>
    }
    else
    {
        <p><em>Nicio resursă alocată.</em></p>
    }

</div>
