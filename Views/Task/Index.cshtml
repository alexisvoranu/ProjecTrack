@model IEnumerable<Licenta3.Models.Task>

@{
    ViewData["Title"] = "Activități";
}

<style>

    .container p, .container h2, .container table, .container td {
        color: black;
    }

    .container th {
        color: white;
    }

    .container table, .container td, .container th {
        text-align: center;
        vertical-align: middle;
    }
</style>

<div class="container py-3">
    <div class="row pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary">Activitățile proiectului <b><i>@ViewBag.projectName</i></b></h2>
        </div>
        <div class="col-12 col-md-6 d-flex flex-column flex-md-row justify-content-md-end align-items-start mt-3 mt-md-0">
            <a asp-controller="Project" asp-action="Index" asp-route-id="@ViewBag.Id"
               class="btn btn-outline-info mx-0 mx-md-1 mb-2 mb-md-0">
                Înapoi
            </a>
            <a asp-controller="Task" asp-action="Create" class="btn btn-success mx-0 mx-md-1 mb-2 mb-md-0">
                Activitate nouă
            </a>
            <a asp-controller="CriticalPath" asp-action="CalculateCriticalPath" asp-route-id="@ViewBag.Id" asp-route-method="CPM" class="btn btn-primary mx-0 mx-md-1 mb-2 mb-md-0">
                Calculează estimarea
            </a>
        </div>
    </div>
</div>

<br />

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped" style="width:100%">
            <thead class="table-primary">
                <tr>
                    <th>
                        Index

                    </th>

                    <th>
                        Cod
                    </th>

                    <th>
                        Denumire
                    </th>

                    <th>
                        Condiționări
                    </th>

                    <th>
                        Durată
                    </th>

                    <th>
                        Resurse
                    </th>
                    <th>
                        Membru echipă
                    </th>
                    <th>
                        Stadiu
                    </th>
                    <th>
                        Acțiuni
                    </th>

                </tr>
            </thead>
            <tbody>
                @{
                    var x = 1;
                }

                @foreach (var obj in Model)
                {
                    <tr>
                        <td width="5%">
                            @x
                        </td>

                        <td width="6%">
                            @obj.Code
                        </td>

                        <td width="26%">
                            @obj.Name
                        </td>

                        <td width="7%">
                            @obj.Dependencies
                        </td>

                        <td width="10%">
                            @obj.Duration @ViewBag.Um
                        </td>
                        <td width="8%">
                            <div class="w-80 btn-group" role="group">
                                <a asp-controller="TaskResource" asp-action="Manage" asp-route-taskId="@obj.Id"
                                   class="btn btn-outline-warning btn-sm"><i class="bi bi-pencil-square"></i>Gestionează</a>
                            </div>
                        </td>
                        <td width="18%">
                            @(string.IsNullOrEmpty(ViewBag.UserNames[x - 1]) ? "Neatribuit încă" : ViewBag.UserNames[x - 1])
                        </td>
                        @{
                            string textColor = "";
                            switch (obj.State)
                            {
                                case "Programată":
                                    textColor = "text-primary";
                                    break;
                                case "În execuție":
                                    textColor = "text-success-emphasis";
                                    break;
                                case "Întârziată":
                                    textColor = "text-danger";
                                    break;
                                case "Finalizată":
                                    textColor = "text-success";
                                    break;
                                case "Începută cu întârziere":
                                    textColor = "text-warning";
                                    break;
                                case "Finalizată cu întârziere":
                                    textColor = "text-warning";
                                    break;
                                default:
                                    textColor = "";
                                    break;
                            }
                        }

                                <td width="10%" class="@textColor">
                                    @obj.State
                                </td>
                                <td width="10%">
                                    <div class="w-80 btn-group" role="group">
                                        <a asp-controller="Task" asp-action="Details" asp-route-id="@obj.Id"
                                           class="btn btn-outline-success mx-1 btn-sm"><i class="bi bi-pencil-square"></i>Detalii</a>

                                        <a asp-controller="Task" asp-action="Edit" asp-route-id="@obj.Id"
                                           class="btn btn-outline-primary mx-1 btn-sm"><i class="bi bi-pencil-square"></i>Editează</a>

                                        <a asp-controller="Task" asp-action="Delete" asp-route-id="@obj.Id"
                                           class="btn btn-outline-danger mx-1 btn-sm"><i class="bi bi-trash-fill"></i>Șterge</a>
                                    </div>
                                </td>
                            </tr>
                            (@x)++;
                }
            </tbody>

        </table>
    </div>
}
else
{
    <div class="card shadow-sm border-0 my-4" style="max-width: 75%; margin: auto; background-color: #f8f9fa;">
        <div class="card-body text-center py-4">
            <h5 class="card-title text-primary mb-3 fw-semibold">
                Nu există activități definite pentru acest proiect
            </h5>
            <p class="card-text text-secondary mb-2">
                Pentru a putea estima durata proiectului și a calcula drumul critic, este necesar să adăugați activitățile componente.
            </p>
            <p class="card-text text-secondary">
                După adăugarea activităților, veți putea vizualiza relațiile dintre ele, aloca resurse și analiza drumul critic.
            </p>
        </div>
    </div>

}


