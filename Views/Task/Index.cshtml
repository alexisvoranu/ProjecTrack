@model IEnumerable<Licenta3.Models.Task>

@{
    ViewData["Title"] = "Activități Proiect";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h6 class="text-uppercase text-muted small fw-bold mb-1">Management Proiect</h6>
            <h2 class="fw-bold text-dark mb-0">
                Activități: <span class="text-primary">@ViewBag.projectName</span>
            </h2>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Project" asp-action="Index" asp-route-id="@ViewBag.Id" class="btn btn-outline-secondary rounded-pill shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Înapoi
            </a>

            <a asp-controller="Task" asp-action="Create" asp-route-id="@ViewBag.Id" class="btn btn-success rounded-pill shadow-sm fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Activitate Nouă
            </a>

            <a asp-controller="CriticalPath" asp-action="CalculateCriticalPath" asp-route-id="@ViewBag.Id" asp-route-method="CPM" class="btn btn-primary rounded-pill shadow-sm fw-bold">
                <i class="bi bi-lightning-charge-fill me-1"></i> Calculează CPM
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <th class="px-3" style="width: 50px;">#</th>
                            <th style="width: 80px;">Cod</th>
                            <th style="min-width: 200px;">Denumire</th>
                            <th class="text-center" style="width: 120px;">Dependențe</th>
                            <th class="text-center" style="width: 100px;">Durată</th>
                            <th class="text-center" style="width: 120px;">Resurse</th>
                            <th style="min-width: 150px;">Responsabil</th>
                            <th class="text-center" style="width: 140px;">Status</th>
                            <th class="text-end px-3" style="min-width: 140px;">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @{
                            var x = 1;
                        }
                        @foreach (var obj in Model)
                        {
                            string badgeClass = "bg-light text-dark";
                            switch (obj.State)
                            {
                                case "Programată": badgeClass = "bg-primary bg-opacity-10 text-primary"; break;
                                case "În execuție": badgeClass = "bg-info bg-opacity-10 text-info-emphasis"; break;
                                case "Finalizată": badgeClass = "bg-success bg-opacity-10 text-success"; break;
                                case "Întârziată": badgeClass = "bg-danger bg-opacity-10 text-danger"; break;
                                case "Începută cu întârziere":
                                case "Finalizată cu întârziere": badgeClass = "bg-warning bg-opacity-10 text-warning-emphasis"; break;
                            }

                            <tr>
                                <td class="px-3 text-muted fw-bold">@x</td>
                                <td><span class="badge bg-info">@obj.Code</span></td>
                                <td class="fw-semibold text-dark">@obj.Name</td>
                                <td class="text-center text-muted small">
                                    @(string.IsNullOrEmpty(obj.Dependencies) ? "-" : obj.Dependencies)
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold">@obj.Duration</span> <small class="text-muted">@ViewBag.Um</small>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="TaskResource" asp-action="Manage" asp-route-taskId="@obj.Id"
                                       class="btn btn-sm btn-outline-dark border-0 bg-info" title="Gestionează Resurse">
                                        Gestionează
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle p-1 me-2 text-secondary d-flex justify-content-center align-items-center" style="width: 28px; height: 28px;">
                                            <i class="bi bi-person-fill small"></i>
                                        </div>
                                        <small class="text-truncate" style="max-width: 130px;">
                                            @(string.IsNullOrEmpty(ViewBag.UserNames[x - 1]) ? "Neatribuit" : ViewBag.UserNames[x - 1])
                                        </small>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill border @badgeClass">@obj.State</span>
                                </td>
                                <td class="text-end px-3">
                                    <div class="btn-group">
                                        <a asp-controller="Task" asp-action="Details" asp-route-id="@obj.Id" class="btn btn-sm btn-link text-primary" title="Detalii">
                                            <i class="bi bi-info"></i>
                                        </a>
                                        <a asp-controller="Task" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-link text-warning" title="Editează">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-controller="Task" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-link text-danger" title="Șterge">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            x++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-3 shadow-sm border mt-4">
            <div class="mb-3">
                <i class="bi bi-list-task text-secondary" style="font-size: 3rem; opacity: 0.3;"></i>
            </div>
            <h5 class="fw-bold text-dark">Nicio activitate definită</h5>
            <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">
                Pentru a estima durata și a calcula drumul critic, începe prin a adăuga activitățile componente ale proiectului.
            </p>
            <a asp-controller="Task" asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Adaugă Prima Activitate
            </a>
        </div>
    }
</div>