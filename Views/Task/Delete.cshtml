@model Licenta3.Models.Task

@{
    ViewData["Title"] = "Șterge activitatea";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-danger shadow-lg">

                <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Ștergere Activitate
                    </h5>
                    <small class="bg-white text-danger px-2 rounded fw-bold">Cod: @Model.Code</small>
                </div>

                <div class="card-body bg-light">
                    <div class="alert alert-warning text-center" role="alert">
                        <strong>Atenție!</strong> Ești sigur că dorești să elimini această activitate?
                        <br />
                        <span class="text-muted small">Această acțiune este permanentă și nu poate fi anulată.</span>
                    </div>

                    <div class="text-center mb-4">
                        <label class="text-muted text-uppercase small" style="letter-spacing: 1px;">Denumire Activitate</label>
                        <h3 class="fw-bold text-dark">@Html.DisplayFor(model => model.Name)</h3>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="fw-bold text-muted small">@Html.DisplayNameFor(model => model.Duration)</label>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-stopwatch me-2 text-primary"></i>
                                <span class="form-control-plaintext border-bottom pb-1">
                                    @Html.DisplayFor(model => model.Duration) @ViewBag.Um
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-muted small">Proiect Părinte</label>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-folder2-open me-2 text-primary"></i>
                                <span class="form-control-plaintext border-bottom pb-1">
                                    @Html.DisplayFor(model => model.Project.Name)
                                </span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="fw-bold text-muted small">@Html.DisplayNameFor(model => model.Dependencies)</label>
                            <div class="p-2 border rounded bg-white text-muted">
                                @if (string.IsNullOrEmpty(Model.Dependencies))
                                {
                                    <span class="fst-italic"><i class="bi bi-check-circle me-1"></i> Fără condiționări (Independentă)</span>
                                }
                                else
                                {
                                    <i class="bi bi-link-45deg me-1"></i>
                                    @Html.DisplayFor(model => model.Dependencies)
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white d-flex justify-content-between align-items-center p-3">
                    <a asp-controller="Task"
                       asp-action="Index"
                       asp-route-id="@Model.ProjectId"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Anulează
                    </a>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="bi bi-trash-fill"></i> Șterge Definitiv
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>