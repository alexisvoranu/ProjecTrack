@using Licenta3.Models
@model Licenta3.Models.Task

@{
    ViewData["Title"] = "Editează Activitate";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                            <i class="bi bi-pencil-square fs-3 text-white"></i>
                        </div>
                        <div style="overflow: hidden;">
                            <h5 class="mb-0 text-white-50 text-uppercase small ls-1">Modificare Activitate</h5>
                            <h3 class="mb-0 fw-bold text-truncate">@Model.Name</h3>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Edit">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="Code" class="form-control shadow-sm" id="floatingCode" placeholder="A, B, C..." />
                                    <label asp-for="Code" for="floatingCode"><i class="bi bi-upc-scan me-1"></i> Cod</label>
                                    <span asp-validation-for="Code" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control shadow-sm" id="floatingName" placeholder="Nume Activitate" />
                                    <label asp-for="Name" for="floatingName"><i class="bi bi-card-text me-1"></i> Denumire Activitate</label>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="Duration" class="form-control shadow-sm" id="floatingDuration" placeholder="0" />
                                    <label asp-for="Duration" for="floatingDuration"><i class="bi bi-stopwatch me-1"></i> Durată</label>
                                    <span asp-validation-for="Duration" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <select asp-for="UserId" class="form-select shadow-sm" asp-items="ViewBag.Users" id="floatingUser">
                                        <option value="">-- Selectează Responsabil --</option>
                                    </select>
                                    <label asp-for="UserId" for="floatingUser"><i class="bi bi-person-badge me-1"></i> Responsabil Echipă</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25">

                        <div class="mb-4">
                            <label asp-for="Dependencies" class="form-label fw-bold text-dark">
                                <i class="bi bi-diagram-2 me-1"></i> Condiționări (Activități Precedente)
                            </label>
                            <div class="alert alert-light border d-flex align-items-center py-2 px-3 mb-2">
                                <i class="bi bi-info-circle text-primary me-2"></i>
                                <small class="text-muted">Ține apăsat <kbd class="bg-light text-dark border">CTRL</kbd> pentru a selecta mai multe activități.</small>
                            </div>
                            <select name="selectedDependencies" class="form-select shadow-sm" multiple asp-items="ViewBag.Dependencies" size="5" style="border: 1px solid #ced4da;"></select>
                        </div>

                        <div class="mb-4">
                            <div class="form-floating">
                                <select asp-for="ProjectId" class="form-select bg-light" asp-items="ViewBag.ProjectId" id="floatingProject"></select>
                                <label asp-for="ProjectId" for="floatingProject"><i class="bi bi-folder2 me-1"></i> Proiect Asociat</label>
                                <span asp-validation-for="ProjectId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-5">
                            <a asp-controller="Task" asp-action="Index" asp-route-id="@Model.ProjectId"
                               class="btn btn-outline-secondary rounded-pill px-4 order-md-1">
                                <i class="bi bi-arrow-left me-2"></i>Anulează
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow fw-bold order-md-2">
                                <i class="bi bi-check-circle-fill me-2"></i>Salvează Modificările
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}