@model Licenta3.Models.Task

@{
    ViewData["Title"] = "Edit";
}

<h2 class="text-primary mt-4">Editează activitatea</h2>

<hr />

@{
    var users = ViewBag.Users as List<ApplicationUser>;
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <div class="form-group">
                <label asp-for="Code" class="control-label">Cod</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Denumire</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Duration" class="control-label">Durată</label>
                <input asp-for="Duration" class="form-control" />
                <span asp-validation-for="Duration" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label">Selectați utilizatorul</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users" id="exampleSelect2">
                    <option value="">-- Selectați un utilizator --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Dependencies" class="control-label">Condiționări</label>
                <select name="selectedDependencies"
                        class="form-control"
                        multiple
                        asp-items="ViewBag.Dependencies">
                </select>
                <span asp-validation-for="Dependencies" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProjectId" class="control-label">Numele proiectului</label>
                <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId"></select>
                <span asp-validation-for="ProjectId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Salvează" class="btn btn-outline-success mt-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-controller="Task" asp-action="Index" asp-route-id="@Model.ProjectId"
       class="btn btn-outline-info mt-2"><i class="bi bi-trash-fill"></i>Înapoi spre lista activităților</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
