@using Licenta3.Models.ViewModels
@model GlobalResourceAllocationViewModel

@{
    ViewData["Title"] = "Portofoliu resurse";
}

<h2 class="text-primary pt-4">Portofoliu resurse</h2>
<br />
<p class="lead pt-0">Vizualizare centralizată a resurselor disponibile și alocate pentru toate proiectele active</p>
<hr />

@if (Model.ProjectsAllocationData == null || !Model.ProjectsAllocationData.Any())
{
    <p class="alert alert-info">Nu au fost găsite proiecte sau resurse alocate.</p>
}
else
{
    <div class="accordion" id="globalProjectsAccordion">
        @{
            int projectIndex = 0;
        }
        @foreach (var projectData in Model.ProjectsAllocationData.Where(p => p.AvailableResources.Any() || p.TaskAllocations.Any()))
        {
            var collapseId = $"collapseProject{projectIndex}";

            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-primary p-0" id="headingProject@(projectIndex)">
                    <h2 class="mb-0">
                        <a class="btn btn-block text-left text-white collapsed w-100 d-flex justify-content-between align-items-center p-3"
                           style="text-align: left; text-decoration: none;"
                           data-bs-toggle="collapse"
                           href="#@collapseId"
                           role="button"
                           aria-expanded="false"
                           aria-controls="@collapseId">

                            <span class="d-flex align-items-center">
                                <i class="fas fa-folder-open me-2"></i>
                                <strong>@projectData.ProjectName</strong>
                            </span>

                            <span class="badge bg-secondary ms-3">
                                (@projectData.TaskAllocations.Sum(a => a.AllocatedResources.Count()) alocări totale)
                            </span>
                        </a>
                    </h2>
                </div>

                <div id="@collapseId" class="collapse" aria-labelledby="headingProject@(projectIndex)" data-bs-parent="#globalProjectsAccordion">
                    <div class="card-body">

                        <div class="row">
                            <div class="col-md-4">
                                <h5 class="text-primary">Resurse disponibile (Total)</h5>
                                <ul class="list-group list-group-flush mb-3">
                                    @if (projectData.AvailableResources.Any())
                                    {
                                        @foreach (var resource in projectData.AvailableResources.OrderBy(r => r.Name))
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                @resource.Name
                                                <span class="badge bg-primary">@resource.Quantity (@resource.MeasurementUnit)</span>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="list-group-item text-muted">Nicio resursă definită.</li>
                                    }
                                </ul>
                            </div>

                            <div class="col-md-8">
                                <h5 class="text-primary">Necesarul activităților</h5>
                                <div class="accordion accordion-flush" id="taskAccordion@(projectIndex)">
                                    @if (projectData.TaskAllocations.Any(a => a.AllocatedResources.Any()))
                                    {
                                        int taskIndex = 0;
                                        @foreach (var allocation in projectData.TaskAllocations.Where(a => a.AllocatedResources.Any()))
                                        {
                                            var taskCollapseId = $"taskCollapse{projectIndex}_{taskIndex}";

                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#@taskCollapseId">
                                                        [@allocation.TaskCode] @allocation.TaskName
                                                    </button>
                                                </h2>
                                                <div id="@taskCollapseId" class="accordion-collapse collapse" data-bs-parent="#taskAccordion@(projectIndex)">
                                                    <ul class="list-group list-group-flush">
                                                        @foreach (var tr in allocation.AllocatedResources)
                                                        {
                                                            <li class="list-group-item">
                                                                @tr.Resource.Name: <b>@tr.QuantityUsed (@tr.Resource.MeasurementUnit)</b>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                            taskIndex++;
                                        }
                                    }
                                    else
                                    {
                                        <p class="alert alert-light mt-2 mb-0">Nicio resursă alocată activităților din acest proiect.</p>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            projectIndex++;
        }
    </div>
}