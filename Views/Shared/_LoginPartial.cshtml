@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);

        <li class="nav-item">
            <a id="manage" class="nav-link active" asp-area="Identity" asp-page="/Account/Manage/Index" title="Administrează contul">
                <i class="bi bi-person-circle me-1"></i> Salut, <span class="fw-bold">@user.FirstName</span>!
            </a>
        </li>

        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link active btn btn-link border-0 bg-transparent text-white-50 shadow-none">
                    <i class="bi bi-box-arrow-right me-1"></i> Deconectare
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link active" id="register" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus-fill me-1"></i> Înregistrare
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link active" id="login" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Autentificare
            </a>
        </li>
    }
</ul>