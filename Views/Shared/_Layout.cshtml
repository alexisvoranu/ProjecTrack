@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ProjecTrack - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/BootswatchTheme.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Licenta3.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .buttons {
            color: white;
        }
    </style>
</head>

<style>
    .navbar-nav .nav-link {
        transition: all 0.3s ease;
        border-radius: 50px;
        padding-left: 15px !important;
        padding-right: 15px !important;
    }

        .navbar-nav .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-1px);
        }

    @@media (max-width: 991.98px) {
        .navbar-collapse

    {
        background-color: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 15px;
        margin-top: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .navbar-nav .nav-link {
        padding-top: 10px;
        padding-bottom: 10px;
        border-radius: 10px;
        margin-bottom: 5px;
    }

        .navbar-nav .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            padding-left: 20px !important;
        }

    .mobile-divider {
        border-top: 1px solid rgba(255,255,255,0.2);
        margin: 10px 0;
        padding-top: 10px;
    }

    }

    .brand-icon {
        background: rgba(255,255,255,0.2);
        padding: 8px;
        border-radius: 12px;
    }
</style>

<body class="d-flex flex-column min-vh-100" style="margin:0; padding:0;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow py-3 sticky-top">

            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center" href="/">
                    ProjecTrack
                </a>

                <button class="navbar-toggler border-0 focus-ring focus-ring-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">

                        @{
                            var user = await UserManager.GetUserAsync(User);
                            var isManager = false;

                            if (user != null)
                            {
                                var roles = await UserManager.GetRolesAsync(user);
                                isManager = roles.Contains("Manager");
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> Despre noi
                            </a>
                        </li>

                        @if (user != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link active"
                                   asp-area=""
                                   asp-controller="@(isManager ? "Project" : "MemberHome")"
                                   asp-action="@(isManager ? "Index" : "Project")">
                                    <i class="bi bi-folder2-open me-1"></i> Proiecte
                                </a>
                            </li>

                            if (isManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area=""
                                       asp-controller="Manager"
                                       asp-action="Members">
                                        <i class="bi bi-people-fill me-1"></i> Echipa
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area=""
                                       asp-controller="Manager"
                                       asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                            }
                        }

                        @RenderSection("Navbar", required: false)
                    </ul>

                    <div class="d-flex flex-lg-row flex-column mobile-divider align-items-lg-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main class="flex-grow-1 mb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (ViewData["HideFooter"] == null)
    {
        <footer class="pt-4 pb-3 mt-auto" style="background:rgb(34, 34, 34); color:#fff;">
            <div class="container">

                <div class="row d-flex align-items-center">

                    <div class="col-md-4 mb-1">
                        <h5 class="fw-bold mb-2">ProjecTrack</h5>
                        <p class="text-white-50 mb-0" style="font-size:0.9rem;">
                            O platformă modernă pentru gestionarea proiectelor, resurselor și activităților într-un mod eficient și intuitiv.
                        </p>
                    </div>

                    <div class="col-md-4 mb-1 text-md-center">
                        <h6 class="fw-bold mb-2">Linkuri utile</h6>
                        <a asp-controller="Home" asp-action="Privacy" class="d-block text-white-50 mb-1 text-decoration-none">
                            Politica de confidențialitate
                        </a>
                        <a asp-controller="Home" asp-action="About" class="d-block text-white-50 text-decoration-none">
                            Despre noi
                        </a>
                    </div>

                    <div class="col-md-4 mb-1 text-md-end">
                        <h6 class="fw-bold mb-2">Contact</h6>
                        <p class="text-white-50 mb-1" style="font-size:0.9rem;">Email: projectrack.ro@gmail.com</p>
                        <p class="text-white-50 mb-0" style="font-size:0.9rem;">Telefon: +40 720 055 759</p>
                    </div>

                </div>

                <hr class="border-secondary" />

                <div class="text-center text-white-50" style="font-size:0.85rem;">
                    © @DateTime.Now.Year ProjecTrack — Toate drepturile rezervate.
                </div>

            </div>
        </footer>
    }

</body>
</html>
