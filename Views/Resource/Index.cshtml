@model IEnumerable<Licenta3.Models.Resource>

@{
    ViewData["Title"] = "Index";
}


<style>

    .container p, .container h2, .container table, .container td {
        color: black;
    }

    .container th {
        color: white;
    }

    .container table, .container td, .container th {
        text-align: center;
        vertical-align: middle;
    }
</style>

<div class="container py-3">
    <div class="row pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary">Activitățile proiectului <b><i>@ViewBag.projectName</i></b></h2>
        </div>
        <div class="col-12 col-md-6 d-flex flex-column flex-md-row justify-content-md-end align-items-start mt-3 mt-md-0">
            <a asp-controller="Project" asp-action="Index" asp-route-id="@ViewBag.Id"
               class="btn btn-outline-info mx-0 mx-md-2 mb-2 mb-md-0"><i class="bi bi-trash-fill"></i>Înapoi spre lista proiectelor</a>
            <a asp-controller="Resource" asp-action="Create" asp-route-projectId="@ViewBag.projectId" class="btn btn-success">
                <i class="bi bi-pencil-square"></i>Adaugă o nouă resursă
            </a>
        </div>
    </div>
</div>

<br />

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped" style="width:100%">
            <thead thead class="table-primary">
                <tr>
                    <th>
                        Denumire
                    </th>

                    <th>
                        Cantitate
                    </th>

                    <th>
                        Unitate de măsură
                    </th>

                    <th>
                        Acțiuni
                    </th>

                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td width="40%">
                            @obj.Name
                        </td>

                        <td width="20%">
                            @obj.Quantity
                        </td>

                        <td width="20%">
                            @obj.MeasurementUnit
                        </td>

                        <td width="20%">
                            <div class="w-80 btn-group" role="group">
                                <a asp-controller="Resource" asp-action="Edit" asp-route-id="@obj.Id"
                                   class="btn btn-outline-warning mx-2 d-flex align-items-center justify-content-center btn-sm">
                                    <i class="bi bi-pencil-square"></i>Editează
                                </a>

                                <a asp-controller="Resource" asp-action="Delete" asp-route-id="@obj.Id"
                                   class="btn btn-outline-danger mx-2 d-flex align-items-center justify-content-center btn-sm">
                                    <i class="bi bi-trash-fill"></i>Șterge
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>Nu există înregistrări disponibile.</p>
}