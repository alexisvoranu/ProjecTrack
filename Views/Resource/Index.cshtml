@model IEnumerable<Licenta3.Models.Resource>

@{
    ViewData["Title"] = "Index";
}


<style>

    .container p, .container h2, .container table, .container td {
        color: black;
    }

    .container th {
        color: white;
    }

    .container table, .container td, .container th {
        text-align: center;
        vertical-align: middle;
    }
</style>


<div class="container p-3">
    <div class="row pt-4">
        <div class="col-9">
            <h2 class="text-primary">Resursele alocate pentru proiectul <b><i>@ViewBag.projectName</i></b></h2>
        </div>
        <div class="col-3 d-flex justify-content-end">
            <a asp-controller="Resource" asp-action="Create" asp-route-projectId="@ViewBag.projectId" class="btn btn-success">
                <i class="bi bi-pencil-square"></i>Adaugă o nouă resursă
            </a>
        </div>
    </div>
</div>

<br />

@if (Model.Any())
{
    <table class="table table-bordered table-striped" style="width:100%">
        <thead thead class="table-primary">
            <tr>
                <th>
                    Denumire
                </th>

                <th>
                    Cantitate
                </th>

                <th>
                    Unitate de măsură
                </th>

                <th>
                    Acțiuni
                </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td width="40%">
                        @obj.Name
                    </td>

                    <td width="20%">
                        @obj.Quantity
                    </td>

                    <td width="20%">
                        @obj.MeasurementUnit
                    </td>

                    <td width="20%">
                        <div class="w-80 btn-group my-2" role="group">
                            <a asp-controller="Resource" asp-action="Edit" asp-route-id="@obj.Id"
                               class="btn btn-outline-primary mx-2 d-flex align-items-center justify-content-center btn-sm">
                                <i class="bi bi-pencil-square"></i>Editează
                            </a>

                            <a asp-controller="Resource" asp-action="Delete" asp-route-id="@obj.Id"
                               class="btn btn-outline-danger mx-2 d-flex align-items-center justify-content-center btn-sm">
                                <i class="bi bi-trash-fill"></i>Șterge
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>
}
else
{
    <p>Nu există înregistrări disponibile.</p>
}