@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{

    ViewData["Title"] = "Acasă";
}

<style>

    .hero-section {
        background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
        color: white;
        padding: 4rem 0;
        border-radius: 50px;
        margin-bottom: 3rem;
        margin-top: 3rem;
    }

    .feature-icon {
        font-size: 2.5rem;
        color: #0d6efd;
        margin-bottom: 1rem;
    }

    .screenshot-placeholder {
        background-color: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-weight: 600;
        transition: transform 0.3s;
        overflow: hidden;
    }

        .screenshot-placeholder:hover {
            transform: scale(1.02);
            border-color: #0d6efd;
        }

    .screenshot-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .step-card {
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: 0.3s;
    }

        .step-card:hover {
            box-shadow: 0 10px 15px rgba(0,0,0,0.15);
        }
</style>

<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Optimizare Inteligentă prin Analiza Drumului Critic</h1>
        <p class="lead mb-4" style="max-width: 700px; margin: 0 auto;">
            Planifică, gestionează și optimizează resursele proiectelor tale. De la calculul automat al CPM până la notificări în timp real pentru echipă.
        </p>

        <div class="d-flex justify-content-center align-items-center flex-column gap-3">

            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);

                <div class="text-white mb-2">
                    <span class="h5">Salutare, <strong>@user?.FirstName</strong>! 👋</span>
                </div>

                <div class="d-flex gap-3">
                    @if (User.IsInRole("Manager"))
                    {
                        <a asp-controller="Project" asp-action="Index" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-primary shadow">
                            Administrare Proiecte
                        </a>
                    }
                    else
                    {
                        <a asp-controller="MemberHome" asp-action="Project" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-success shadow">
                            Proiectele Mele
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="d-flex flex-column flex-sm-row gap-3">

                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light btn-lg rounded-pill px-4 fw-bold text-primary shadow">
                        <i class="bi bi-person-plus-fill me-2"></i> Începe Acum
                    </a>

                    <a asp-controller="Demo" asp-action="Index" class="btn btn-warning btn-lg rounded-pill px-4 fw-bold text-dark shadow">
                        <i class="bi bi-play-circle-fill me-2"></i> Încearcă Demo
                    </a>

                    <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg rounded-pill px-4">
                        <i class="bi bi-info-circle me-2"></i> Află Mai Multe
                    </a>
                </div>

                <small class="mt-2">
                    * Modul Demo nu necesită cont și folosește date fictive.
                </small>
            }

        </div>
    </div>
</div>

<div class="container" id="features">
    <div class="row text-center mb-5 g-4">
        <div class="col-md-4">
            <div class="card h-100 p-4 step-card">
                <div class="card-body">

                    <div class="feature-icon">📊</div> <h3 class="h5 fw-bold">Calcul Drum Critic (CPM)</h3>

                    <p class="text-muted">Algoritm automat care identifică activitățile critice. Vizualizare grafică interactivă și export PNG instant.</p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-4 step-card">
                <div class="card-body">
                    <div class="feature-icon">👥</div>
                    <h3 class="h5 fw-bold">Alocare & Optimizare Resurse</h3>
                    <p class="text-muted">Distribuie resursele eficient. Generează histograme și nivelează încărcarea pentru a evita depășirile.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-4 step-card">
                <div class="card-body">
                    <div class="feature-icon">🚀</div>
                    <h3 class="h5 fw-bold">Dashboard & Notificări</h3>
                    <p class="text-muted">Viziune de ansamblu în timp real. Email automat către manageri la actualizarea statusului de către echipă.</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5 text-muted">

    <div class="row align-items-center mb-5">
        <div class="col-lg-6 order-lg-2">
            <div class="screenshot-placeholder shadow-lg">
                <img src="/images/Grafic.png" alt="Grafic Drum Critic" class="screenshot-img" onerror="this.style.display='none'; this.parentElement.innerText='[Screenshot: Graficul Drumului Critic]'">
            </div>
        </div>

        <div class="col-lg-6 order-lg-1">
            <span class="badge bg-primary mb-2">Vizualizare Grafică</span>
            <h2 class="fw-bold">Vizualizează Proiectul în Detaliu</h2>
            <p class="lead text-muted">Nu doar cifre, ci o hartă clară a proiectului.</p>
            <p>Aplicația transformă lista de activități într-un grafic de tip rețea, evidențiind cu roșu activitățile critice care nu permit întârzieri.</p>
            <ul class="list-unstyled mt-3">

                <li class="mb-2"><i class="bi bi-check-circle text-primary me-2"></i> Identificare automată a drumului critic</li>

                <li class="mb-2"><i class="bi bi-check-circle text-primary me-2"></i> Adăugare dinamică de activități</li>

                <li class="mb-2"><i class="bi bi-check-circle text-primary me-2"></i> <strong>Export PNG</strong> pentru rapoarte externe</li>

            </ul>
        </div>
    </div>

    <div class="row align-items-center mb-5">
        <div class="col-lg-6">
            <div class="screenshot-placeholder shadow-lg">
                <img src="/images/Histograma.png" alt="Histograma Resurse" class="screenshot-img" onerror="this.style.display='none'; this.parentElement.innerText='[Screenshot: Histograma Resurse & Optimizare]'">
            </div>
        </div>

        <div class="col-lg-6">
            <span class="badge bg-success mb-2">Resurse</span>
            <h2 class="fw-bold">Optimizarea și Nivelarea Resurselor</h2>
            <p class="lead text-muted">Evită supraîncărcarea echipei sau a materialelor.</p>
            <p>Fiecare proiect are resurse limitate. Dashboard-ul îți permite să vezi histograma de consum și să aplici algoritmi de optimizare pentru a te încadra în necesar.</p>
            <p>Managerii pot vedea exact cine este alocat, unde și dacă există conflicte de disponibilitate.</p>
        </div>
    </div>

    <div class="row mt-5 mb-5 p-5 bg-light rounded-3">
        <div class="col-12 text-center mb-4">
            <h2 class="fw-bold">Flux de Lucru Colaborativ</h2>
        </div>

        <div class="col-md-6 border-end">
            <div class="p-3 text-center">
                <h4 class="text-primary fw-bold">Manager de Proiect</h4>
                <ul class="list-group list-group-flush bg-transparent text-start mt-3">

                    <li class="list-group-item bg-transparent">➕ Crează proiecte și definește activități</li>

                    <li class="list-group-item bg-transparent">📉 Calculează drumul critic și vede grafice</li>

                    <li class="list-group-item bg-transparent">👤 Asignează membrii echipei disponibili</li>

                    <li class="list-group-item bg-transparent">📊 Accesează Dashboard-ul global</li>

                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-3 text-center">
                <h4 class="text-success fw-bold">Membru Echipă</h4>
                <ul class="list-group list-group-flush bg-transparent text-start mt-3">

                    <li class="list-group-item bg-transparent">👁️ Vede proiectele la care este asignat</li>

                    <li class="list-group-item bg-transparent">⚠️ Vizualizează estimările critice</li>

                    <li class="list-group-item bg-transparent">✅ Actualizează starea (Start/Finalizare)</li>

                    <li class="list-group-item bg-transparent">📧 Sistemul notifică automat managerul</li>

                </ul>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid bg-dark text-white py-5 mt-5">
    <div class="container text-center">

        @if (SignInManager.IsSignedIn(User))
        {
            <h2 class="mb-4">Ești gata să continui munca?</h2>
            <p class="mb-4 text-white-50">Accesează rapid dashboard-ul și verifică statusul activităților.</p>

            @if (User.IsInRole("Manager"))
            {
                <a asp-controller="Project" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">
                    Mergi la Proiecte
                </a>
            }
            else
            {
                <a asp-controller="MemberHome" asp-action="Project" class="btn btn-success btn-lg rounded-pill px-5">
                    Activitățile Mele
                </a>
            }
        }
        else
        {
            <h2 class="mb-4">Gata să optimizezi următorul proiect?</h2>
            <p class="mb-4 text-white-50">Creează-ți un cont gratuit și preia controlul asupra termenelor limită.</p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg rounded-pill px-4">
                    Creează Cont
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg rounded-pill px-4">
                    Autentificare
                </a>
            </div>
        }

    </div>
</div>