@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        background-color: #f4f6f8;
        color: #333;
    }

    main {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        padding: 40px 10px;
    }

    section.box {
        background-color: #ffffff;
        padding: 20px;
        border-radius: 20px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        section.box:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
        }

        section.box img {
            width: 100%;
            border-radius: 20px;
            margin-bottom: 15px;
            object-fit: cover;
        }

    .card-home {
        background-color: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        padding: 40px;
        max-width: 900px;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .card-home:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }


        .card-home h3 {
            color: #158cba;
            font-weight: 700;
            margin-bottom: 40px;
        }

        .card-home p {
            color: #555;
            line-height: 1.7;
        }

        .card-home a.btn-primary {
            padding: 10px 25px;
            border-radius: 50px;
            font-weight: 500;
            transition: 0.3s;
        }

            .card-home a.btn-primary:hover {
                background-color: #0d6ea8;
                transform: translateY(-2px);
            }

    .centered-paragraphs p {
        text-align: center;
        justify-content: center;
    }

    .centered-paragraphs p {
        text-align: justify;
    }

</style>

<main>
    <div class="card-home text-center">
        <h3>Bun venit la <strong>ProjecTrack</strong>!</h3>
        <p><strong>ProjecTrack</strong> este o aplicație concepută pentru <strong>optimizarea planificării și monitorizării proiectelor</strong>. Platforma oferă managerilor instrumente pentru definirea activităților, calculul automat al <strong>drumului critic</strong> și reprezentarea grafică a acestuia, facilitând identificarea dependențelor și a întârzierilor posibile.</p>
        <p>Prin intermediul <strong>histogramelor de resurse</strong> și al funcțiilor de <strong>optimizare a distribuției acestora</strong>, aplicația contribuie la o utilizare eficientă a timpului și a resurselor, oferind o perspectivă clară asupra progresului fiecărui proiect. Totodată, membrii echipei pot actualiza în timp real <strong>stadiul activităților</strong>, notificând automat managerii de proiect cu privire la progresul sau finalizarea acestora.</p>

        @{
            var user = await UserManager.GetUserAsync(User);
            if (user != null)
            {
                var roles = await UserManager.GetRolesAsync(user);

                if (roles.Contains("Manager"))
                {
                    <p class="pb-0 mb-0">
                        Bine ai revenit! 👋
                        Pentru a continua, intră în secțiunea
                        <a asp-controller="Project" asp-action="Index"><strong>Proiecte</strong></a>
                        și explorează toate funcționalitățile disponibile.
                    </p>

                }
                else
                {
                    <p class="pb-0 mb-0">
                        Bine ai revenit! 👋
                        Pentru a începe, mergi la
                        <a asp-controller="MemberHome" asp-action="Project"><strong>Proiecte</strong></a>
                        și urmărește activitățile din echipa ta.
                    </p>
                }
            }
            else
            {
                <p class="pb-0 mb-0">
                    Pentru a începe, <a asp-area="Identity" asp-page="/Account/Login">autentifică-te</a> sau
                    <a asp-area="Identity" asp-page="/Account/Register">creează un cont</a> și descoperă funcționalitățile aplicației.
                </p>
            }
        }
    </div>

    <section class="box centered-paragraphs">
        <div class="centered-paragraphs box">
            <img src="https://images.ctfassets.net/pdf29us7flmy/6V6w0sa0xbY1Ww0445kCuh/100c8a635c2206957be068327c5f452f/critical-path-analysis-steps.png?w=720&q=100&fm=avif" style="width: 100%; height: auto; border-radius: 12px; object-fit: cover;" />
            <p class="mt-2">
                Calcularea drumului critic manual este un proces consumator de timp și laborios, implicând
                crearea unei diagrame de rețea pentru a vizualiza sarcinile proiectului și dependențele acestora.
                Această metodă manuală este predispusă la erori și poate să nu ofere actualizări în timp real pe
                măsură ce proiectul progresează. În era digitală modernă, aplicațiile online au făcut mult mai ușor
                pentru managerii de proiect să calculeze drumul critic în mod precis și eficient.
            </p>
            <p>
                Optimizarea managementului proiectelor scurtează termenele de finalizare, îmbunătățind
                satisfacția clienților și consolidând relațiile cu aceștia. Utilizarea unei aplicații web dedicate pentru managementul proiectelor poate oferi
                beneficii semnificative în ceea ce privește eficiența operațională a companiei, prin disponibilitatea
                datelor și rapoartelor detaliate, optimizând procesul de monitorizare și evaluare a proiectelor,
                reducerea costurilor asociate cu întârzierile și depășirile bugetare.
            </p>
        </div>

        <div class="text-center mt-5">
            <h4 class="text-primary mb-4">Știați că…?</h4>
            <div class="centered-paragraphs" style="text-align: justify; max-width: 80%; margin: auto;">
                <p>
                    Potrivit studiului Pulse of the Profession 2023, <strong>aproximativ 70% dintre proiecte</strong> depășesc timpul sau bugetul planificat din cauza lipsei unei planificări eficiente.
                </p>
                <p>
                    Datele publicate de Project Management Institute (PMI) arată că <strong>doar 31% dintre proiecte</strong> sunt finalizate complet conform obiectivelor inițiale, subliniind importanța monitorizării constante și a metodologiilor de planificare.
                </p>
                <p class="pb-0 mb-0">
                    Conform raportului Standish Group Chaos 2022, <strong>aproximativ 50% dintre proiecte</strong> eșuează sau nu își ating obiectivele inițiale din cauza comunicării deficitare între echipe și managementul riscurilor.
                </p>
            </div>
        </div>
    </section>

</main>

<main>
    <section class="box centered-paragraphs">
        <img src="https://cdn.sanity.io/images/tlr8oxjg/production/d63904e726e42ae2491c29106065e9762dbcccde-1456x816.png?w=3840&q=80&fit=clip&auto=format" />
        <p>
            Managementul proiectelor reprezintă un instrument esențial în planificarea, coordonarea,
            implementarea și monitorizarea activităților complexe în diverse domenii comerciale, industriale,
            sociale, culturale și politice, având ca scop motivarea tuturor participanților pentru a atinge
            obiecivele proiectului într-un mod sigur, respectând timpul, costul și criteriile de performanță
            stabilite. Nevoile proiectului sunt definite de beneficiari și trebuie înțelese în mod clar de către cei
            care realizează sau furnizează produsul/serviciul, având în vedere și impactul pe care acesta îl va
            avea asupra comunității. Acest obiectiv este relevant pentru toate tipurile de proiecte, indiferent
            de domeniul în care se aplică.
        </p>
    </section>
    <section class="box centered-paragraphs">
        <img src="https://images.business.com/app/uploads/2011/06/12131215/Leadership-Skills.png" />
        <p>
            În mediul actual al afacerilor, managementul proiectelor reprezintă un element crucial pentru
            succesul și competitivitatea organizațiilor. Cu toate acestea, companiile se confruntă cu diverse
            provocări, inclusiv cerințe tot mai complexe din partea clienților și resurse limitate. În acest
            context, dezvoltarea și utilizarea aplicațiilor web specializate pentru gestionarea eficientă a
            proiectelor devine o strategie importantă pentru optimizarea proceselor și obținerea unui avantaj
            competitiv. Cea mai mare provocare în domeniul managementului proiectelor este asigurarea unei
            planificări eficiente și a unei execuții adecvate.
        </p>
    </section>
    <section class="box centered-paragraphs">
        <img src="https://www.projectmanager.com/wp-content/uploads/2024/02/Henry-Gantts-Biography-1.jpg" />
        <p>
            În 1917, Henry Gantt, recunoscut ca unul dintre pionierii în tehnici de planificare și control,
            a efectuat studii asupra secvenței proceselor de lucru, rezultând dezvoltarea celebrei diagrame
            Gantt ca un instrument esențial în planificarea muncii. În acea perioadă, managerii de proiecte
            militare recurgeau la elaborarea manuală a planurilor pentru a comunica sarcinile ce trebuiau
            finalizate în limite temporale precise. Această inovație a devenit ulterior un standard în domeniul
            planificării și revizuirii activităților necesare pentru completarea unui proiect. În 1957, colaborarea
            dintre DuPont și Remington Rand Corporation a condus la dezvoltarea Metodei Drumului Critic
            (CPM), destinată coordonării proiectelor de întreținere a instalațiilor.
        </p>
    </section>

</main>
