@model Licenta3.Models.Project

@{
    ViewData["Title"] = "Edit";
}

<h2 class="text-primary mt-4">Editează proiectul</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label">Nume</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartingDate" class="control-label">Data de începere</label>
                <input asp-for="StartingDate" class="form-control" />
                <span asp-validation-for="StartingDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MeasurementUnit" class="control-label">Unitate de măsură</label>
                <select asp-for="MeasurementUnit" class="form-select" id="exampleSelect1">
                    <option>minute</option>
                    <option>ore</option>
                    <option>zile</option>
                    <option>săptămâni</option>
                    <option>luni</option>
                    <option>ani</option>
                </select>
            </div>
            <input type="hidden" asp-for="UserId" />

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-outline-success mt-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-controller="Project" asp-action="Index"
       class="btn btn-outline-info mt-2"><i class="bi bi-trash-fill"></i>Înapoi spre lista proiectelor</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
