@model Licenta3.Models.Project
@{
    ViewData["Title"] = "Editează Proiect";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                            <i class="bi bi-pencil-square fs-3 text-white"></i>
                        </div>
                        <div style="overflow: hidden;">
                            <h5 class="mb-0 text-white-50 text-uppercase small ls-1">Editează Proiectul</h5>
                            <h3 class="mb-0 fw-bold text-truncate">@Model.Name</h3>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control shadow-sm" placeholder="Nume Proiect" id="floatingName" />
                            <label asp-for="Name" for="floatingName"><i class="bi bi-card-text me-1"></i> Denumire Proiect</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="StartingDate" type="date" class="form-control shadow-sm" id="floatingDate" />
                                    <label asp-for="StartingDate" for="floatingDate"><i class="bi bi-calendar-event me-1"></i> Data de început</label>
                                    <span asp-validation-for="StartingDate" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <select asp-for="MeasurementUnit" class="form-select shadow-sm" id="floatingUnit">
                                        <option value="zile">zile</option>
                                        <option value="săptămâni">săptămâni</option>
                                        <option value="luni">luni</option>
                                        <option value="ani">ani</option>
                                    </select>
                                    <label asp-for="MeasurementUnit" for="floatingUnit"><i class="bi bi-hourglass-split me-1"></i> Unitate timp</label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning border-warning d-flex align-items-start mt-2 mb-4 bg-opacity-10">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-2 mt-1"></i>
                            <div class="small text-muted">
                                <strong>Atenție:</strong> Modificarea unității de măsură poate afecta interpretarea duratelor pentru activitățile deja existente.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow fw-bold">
                                <i class="bi bi-check-circle-fill me-2"></i>Salvează Modificările
                            </button>

                            <a asp-controller="Project" asp-action="Index" class="btn btn-outline-secondary rounded-pill mt-2 border-0">
                                <i class="bi bi-arrow-left me-2"></i>Renunță și Înapoi
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}