@using Licenta3.Models.ViewModels
@model IEnumerable<ProjectDashboardViewModel>

@{
    ViewData["Title"] = "Proiecte";
}

<style>
    .project-card {
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
        background: white;
        overflow: hidden;
    }

        .project-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }

    .status-badge {
        font-size: 0.8rem;
        padding: 0.5em 0.8em;
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-programat {
        background-color: #e3f2fd;
        color: #0d6efd;
    }

    .status-executie {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .status-intarziat {
        background-color: #f8d7da;
        color: #842029;
    }

    .status-finalizat {
        background-color: #d1e7dd;
        color: #198754;
    }

    .accordion-button:not(.collapsed) {
        background-color: #f8f9fa;
        color: #0d6efd;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
    }

    .resource-tag {
        font-size: 0.75rem;
        background: #f1f3f5;
        color: #495057;
        padding: 2px 8px;
        border-radius: 4px;
        margin-right: 4px;
        display: inline-block;
        margin-bottom: 2px;
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 pb-3 border-bottom">
        <div>
            <h6 class="text-uppercase text-muted small fw-bold mb-1">Portofoliu</h6>
            <h2 class="fw-bold text-dark mb-0">Proiecte Curente</h2>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Project" asp-action="Create" class="btn btn-success btn-lg rounded-pill shadow-sm">
                <i class="bi bi-plus-lg me-2"></i> Proiect Nou
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="accordion" id="projectsAccordion">
            @foreach (var item in Model)
            {
                var project = item.Project;
                var tasks = item.Tasks;

                string statusClass = "bg-light text-dark";
                string icon = "bi-circle";
                switch (project.State)
                {
                    case "Programat": statusClass = "status-programat"; icon = "bi-calendar"; break;
                    case "În execuție": statusClass = "status-executie"; icon = "bi-play-circle"; break;
                    case "Întârziat": statusClass = "status-intarziat"; icon = "bi-exclamation-circle"; break;
                    case "Finalizat": statusClass = "status-finalizat"; icon = "bi-check-circle-fill"; break;
                }

                var collapseId = "collapse_" + project.Id;

                <div class="card project-card shadow-lg mb-4">
                    <div class="card-body p-0">
                        <div class="row g-0 align-items-center p-4">

                            <div class="col-lg-3 mb-3 mb-lg-0">
                                <div class="d-flex align-items-center">

                                    <div>
                                        <h5 class="fw-bold mb-1">
                                            <a asp-controller="Project"
                                               asp-action="Details"
                                               asp-route-id="@project.Id"
                                               class="text-dark text-decoration-none">
                                                @project.Name
                                            </a>
                                        </h5>
                                        <span class="badge @statusClass border-0">
                                            <i class="bi @icon me-1"></i> @project.State
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-2 mb-3 mb-lg-0 px-lg-4">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Data de începere</small>
                                <p class="mb-0 fw-semibold">
                                    <i class="bi bi-calendar-event me-2 text-muted"></i>
                                    @project.StartingDate.ToString("dd MMM yyyy")
                                </p>
                            </div>

                            <div class="col-lg-7 d-flex flex-column flex-lg-row justify-content-lg-end gap-2 align-items-center mt-3 mt-lg-0">

                                <div class="d-flex gap-2 order-1 order-lg-2 w-lg-auto justify-content-center justify-content-lg-end mb-2 mb-lg-0">

                                    <button class="btn btn-outline-primary rounded-pill btn-sm collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false">
                                        Resurse & Activități <i class="bi bi-chevron-down ms-1"></i>
                                    </button>

                                    <a asp-controller="CriticalPath" asp-action="CalculateCriticalPath" asp-route-id="@project.Id"
                                       class="btn btn-outline-success rounded-pill btn-sm" type="button">
                                        Estimare CPM
                                    </a>
                                </div>

                                <div class="btn-group order-2 order-lg-1" role="group">
                                    <a asp-controller="Project" asp-action="Details" asp-route-id="@project.Id" class="btn btn-lg btn-link text-primary" title="Detalii">
                                        <i class="bi bi-info"></i>
                                    </a>
                                    <a asp-controller="Project" asp-action="Edit" asp-route-id="@project.Id" class="btn btn-lg btn-link text-warning" title="Editează">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-controller="Project" asp-action="Delete" asp-route-id="@project.Id" class="btn btn-lg btn-link text-danger" title="Șterge">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#projectsAccordion">
                        <div class="card-footer bg-light p-4 border-top">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-primary mb-0">
                                    <i class="bi bi-list-task me-2"></i>Lista Activități și Resurse Alocate
                                </h6>

                                <div>
                                    <a asp-controller="Resource" asp-action="Index" asp-route-projectId="@project.Id"
                                       class="btn btn-sm btn-link text-decoration-none me-2">
                                        <i class="bi bi-layers-half"></i> Gestionează resursele
                                    </a>

                                    <a asp-controller="Task" asp-action="Index" asp-route-id="@project.Id"
                                       class="btn btn-sm btn-link text-decoration-none">
                                        Editează activitățile <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>

                            @if (tasks != null && tasks.Any())
                            {
                                <div class="list-group shadow-sm">
                                    @foreach (var task in tasks)
                                    {
                                        <div class="list-group-item list-group-item-action p-3 border-0 border-bottom">
                                            <div class="row align-items-center">
                                                <div class="col-md-5">
                                                    <span class="badge bg-secondary me-2">@task.Code</span>
                                                    <span class="fw-semibold">@task.Name</span>
                                                </div>

                                                <div class="col-md-7">
                                                    @if (task.TaskResources != null && task.TaskResources.Any())
                                                    {
                                                        <div class="d-flex flex-wrap align-items-center">
                                                            <small class="text-muted me-2">Resurse:</small>
                                                            @foreach (var res in task.TaskResources)
                                                            {
                                                                var resName = res.Resource != null ? res.Resource.Name : "Resursă";
                                                                var unit = res.Resource != null ? res.Resource.MeasurementUnit : "";

                                                                <span class="resource-tag border">
                                                                    @resName: <strong>@res.QuantityUsed @unit</strong>
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-muted fst-italic">Nicio resursă alocată.</small>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-3 text-muted">
                                    <i class="bi bi-clipboard-x fs-4 d-block mb-2"></i>
                                    Nu există activități definite pentru acest proiect.
                                    <br>
                                    <a asp-controller="Task" asp-action="Create" asp-route-id="@project.Id" class="btn btn-sm btn-outline-success mt-2">
                                        + Adaugă Activitate
                                    </a>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-5 bg-white rounded-3 shadow-sm border border-light">
            <div class="mb-4">
                <i class="bi bi-folder-plus text-secondary" style="font-size: 4rem; opacity: 0.5;"></i>
            </div>
            <h4 class="fw-bold text-dark">Nu există proiecte momentan</h4>
            <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">
                Începe prin a crea primul tău proiect. Vei putea apoi să definești activități, să aloci resurse și să calculezi drumul critic.
            </p>
            <a asp-controller="Project" asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-5 shadow">
                Creează Proiect Acum
            </a>
        </div>
    }
</div>