@model IEnumerable<Licenta3.Models.Project>

@{
    ViewData["Title"] = "Proiecte";
}

<style>

    .container p, .container h2, .container table, .container td {
        color: black;
    }

    .container th {
        color: white;
    }

    .container table, .container td, .container th {
        text-align: center;
        vertical-align: middle;
    }
</style>

<div class="container py-3">
    <div class="row pt-4">
        <div class="col-12 col-md-6">
            <h2 class="text-primary">Proiectele curente</h2>
        </div>
        <div class="col-12 col-md-6 d-flex flex-column flex-md-row justify-content-md-end align-items-start mt-3 mt-md-0">
            <a asp-controller="Project" asp-action="Create" class="btn btn-success">
                <i class="bi bi-pencil-square"></i> Creează un nou proiect
            </a>
        </div>
    </div>
</div>

<br />

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped" style="width:100%">
            <thead thead class="table-primary">
                <tr>
                    <th>
                        Denumirea proiectului
                    </th>

                    <th>
                        Data de începere
                    </th>

                    <th>
                        Stadiu
                    </th>

                    <th>
                        Acțiuni
                    </th>


                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td width="25%">
                            @obj.Name
                        </td>

                        <td width="20%">
                            @obj.StartingDate
                        </td>

                        @{
                            string textColor = "";
                            switch (obj.State)
                            {
                                case "Programat":
                                    textColor = "text-primary";
                                    break;
                                case "În execuție":
                                    textColor = "text-success-emphasis";
                                    break;
                                case "Întârziat":
                                    textColor = "text-danger";
                                    break;
                                case "Finalizat":
                                    textColor = "text-success";
                                    break;
                                default:
                                    textColor = "";
                                    break;
                            }
                        }

                        <td width="10%" class="@textColor">
                            @obj.State
                        </td>

                        <td width="35%">
                            <div class="w-80 d-flex my-1" role="group">
                                <a asp-controller="Task" asp-action="Index" asp-route-id="@obj.Id"
                                   class="btn btn-outline-success mx-1 d-flex align-items-center justify-content-center btn-sm">
                                    <i class="bi bi-trash-fill"></i>Vezi activitățile
                                </a>


                                <a asp-controller="Resource" asp-action="Index" asp-route-projectId="@obj.Id"
                                   class="btn btn-outline-primary mx-1 d-flex align-items-center justify-content-center btn-sm">
                                    <i class="bi bi-trash-fill fs-6"></i>Gestionează resursele
                                </a>

                                <a asp-controller="Project" asp-action="Edit" asp-route-id="@obj.Id"
                                   class="btn btn-outline-warning mx-1 d-flex align-items-center justify-content-center btn-sm">
                                    <i class="bi bi-trash-fill"></i>Editează
                                </a>

                                <a asp-controller="Project" asp-action="Delete" asp-route-id="@obj.Id"
                                   class="btn btn-outline-danger mx-1 d-flex align-items-center justify-content-center btn-sm">
                                    <i class="bi bi-trash-fill"></i>Șterge
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}
else
{
    <div class="card shadow-sm border-0 my-4" style="max-width: 75%; margin:auto; background-color: #f8f9fa;">
        <div class="card-body text-center py-4">
            <h5 class="card-title text-primary mb-3 fw-semibold">
                Nu există proiecte disponibile momentan
            </h5>
            <p class="card-text text-secondary mb-2">
                Pentru a începe procesul de planificare, vă rugăm să creați un nou proiect.
            </p>
            <p class="card-text text-secondary">
                După adăugarea acestuia, veți putea defini activitățile, aloca resurse, calcula drumul critic și genera diagramele de analiză ale proiectului.
            </p>
        </div>
    </div>
}