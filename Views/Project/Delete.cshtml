@model Licenta3.Models.Project
@{
    ViewData["Title"] = "Șterge Proiect";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-danger text-white p-4 rounded-top-4 text-center">
                    <i class="bi bi-exclamation-octagon-fill display-3 mb-2"></i>
                    <h4 class="mb-0 fw-bold">Confirmare Ștergere</h4>
                </div>

                <div class="card-body p-4 p-md-5 text-center bg-white">

                    <p class="text-muted mb-4">Ești pe cale să ștergi definitiv următorul proiect:</p>

                    <div class="bg-light rounded-3 p-3 mb-4 border">
                        <h2 class="fw-bold text-dark mb-1">@Model.Name</h2>
                        <small class="text-muted">
                            <i class="bi bi-calendar-event me-1"></i>Start: @Model.StartingDate.ToString("dd MMM yyyy")
                        </small>
                    </div>

                    <div class="alert alert-warning d-flex align-items-start text-start mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-4"></i>
                        <div class="small">
                            <strong>Atenție:</strong> Această acțiune este ireversibilă. Toate activitățile, resursele alocate și graficele asociate acestui proiect vor fi șterse permanent din baza de date.
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill shadow fw-bold">
                                <i class="bi bi-trash3-fill me-2"></i>Da, Șterge Proiectul
                            </button>

                            <a asp-controller="Project" asp-action="Index" class="btn btn-outline-secondary rounded-pill mt-2 border-0">
                                <i class="bi bi-x-lg me-2"></i>Nu, Anulează
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>