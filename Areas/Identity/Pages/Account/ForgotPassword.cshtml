@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Ai uitat parola?";
}

<h1 style="margin-top: 2rem">@ViewData["Title"]</h1>
<hr />
<div class="row">
    <h4 class="text-primary" style="margin-bottom: 2rem">Completează adresa de e-mail existentă pentru care vrei să resetezi parola.</h4>
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary my-3">Resetează parola</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
