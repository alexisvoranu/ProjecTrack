@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Ai uitat parola?";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4 text-center">
                    <div class="mb-3">
                        <div class="d-inline-block bg-white bg-opacity-25 rounded-circle p-3">
                            <i class="bi bi-shield-lock-fill fs-1 text-white"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0">Recuperare Parolă</h3>
                    <small class="text-white-50">Vom trimite instrucțiunile pe email.</small>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">

                    <p class="text-center text-muted mb-4 small">
                        Completează adresa de e-mail asociată contului tău și îți vom trimite un link pentru a reseta parola.
                    </p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email"><i class="bi bi-envelope me-2"></i>Adresă de Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow fw-bold">
                                <i class="bi bi-send-fill me-2"></i>Trimite Link Resetare
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light p-3 rounded-bottom-4 border-top-0 text-center">
                    <a asp-page="./Login" class="text-decoration-none text-secondary fw-bold small hover-primary">
                        <i class="bi bi-arrow-left me-1"></i> Înapoi la Autentificare
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}