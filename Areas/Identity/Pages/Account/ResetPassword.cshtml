@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Resetează parola";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white p-4 rounded-top-4 text-center">
                    <div class="mb-3">
                        <div class="d-inline-block bg-white bg-opacity-25 rounded-circle p-3">
                            <i class="bi bi-arrow-repeat fs-1 text-white"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0">Resetează Parola</h3>
                    <small class="text-white-50">Introdu adresa de email și alege o parolă nouă.</small>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <input asp-for="Input.Code" type="hidden" />

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control shadow-sm" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email"><i class="bi bi-envelope me-2"></i>Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control shadow-sm" autocomplete="new-password" aria-required="true" placeholder="Parola nouă" />
                            <label asp-for="Input.Password"><i class="bi bi-shield-lock me-2"></i>Parolă Nouă</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control shadow-sm" autocomplete="new-password" aria-required="true" placeholder="Confirmare" />
                            <label asp-for="Input.ConfirmPassword"><i class="bi bi-shield-check me-2"></i>Confirmă Parola</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow fw-bold">
                                <i class="bi bi-check-circle-fill me-2"></i> Salvează Noua Parolă
                            </button>
                        </div>

                    </form>
                </div>

                <div class="card-footer bg-light p-3 rounded-bottom-4 border-top-0 text-center">
                    <a asp-page="./Login" class="text-decoration-none text-secondary fw-bold small hover-primary">
                        <i class="bi bi-x-circle me-1"></i> Renunță și mergi la Autentificare
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}